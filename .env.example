# WebLead AI — environment template (NO real secrets here)
# Copy to .env and fill with real values. .env is gitignored.
# No key is ever assumed to exist: empty means "not configured".

# --- Database (PostgreSQL 16, dev local) ---
# Example only — use your own local credentials.
DATABASE_URL="postgresql://weblead:CHANGE_ME@localhost:5432/weblead_dev"

# --- API ---
API_PORT=4000

# --- LLM providers (multiprovider, §3) ---
# Active by default: top-tools-ai / Top-Tools-Ai-Basic — the only provider
# verified working in Fase A (0.00 USD, 805 tokens / 4 dossiers).
# xAI: registered credential INVALID (400 Incorrect API key).
# CoArena: registered key REVOKED (401 api_key_revoked).
# Groq (first candidate) and OpenRouter (alternative): NO keys assumed.
# Their real key check is Fase B work. Leave empty until Jon provides them.
LLM_PROVIDER=top-tools-ai
LLM_MODEL=Top-Tools-Ai-Basic
LLM_BASE_URL=https://top-tools-ai.com/api/v1
# Comma-separated fallback chain, tried in order after the primary provider.
LLM_FALLBACK_PROVIDERS=
# Set the real keys only in .env (never here, never in git):
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOP_TOOLS_API_KEY=
XAI_API_KEY=
COARENA_API_KEY=
# Apify (Fase C candidate — no calls, no account, no credit consumed in Fase 0):
APIFY_API_KEY=

# --- Gmail (OAuth, Fase E) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Cost control (§8) ---
# Reference budget: 30 EUR/month additional, max.
MONTHLY_BUDGET_EUR=30
# Effective authorised spend: ZERO until Jon expressly approves a spend.
# While 0, paid LLM calls are blocked; only verified free-tier calls run.
EFFECTIVE_SPEND_LIMIT_EUR=0
